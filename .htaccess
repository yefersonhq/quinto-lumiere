# Quinto Lumière — Apache / LiteSpeed (Hostinger)

Options -Indexes
DirectoryIndex index.php

# ----- Bloquear archivos internos -----
<FilesMatch "^(config\.php|.*\.sqlite.*|.*\.md|.*\.ini|.*\.log)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(inc|data|_dev)(/|$)

# ----- HTTPS -----
# El cambio a https lo hace la tienda automáticamente cuando en config.php
# site_url empieza con https:// (así no se rompe si el SSL aún no está activo).

# ----- Caché: código siempre fresco, imágenes en caché -----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 hours"
  ExpiresByType application/javascript "access plus 1 hours"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/javascript .js
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
